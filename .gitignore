# =============================================================================
# Next.js / Node
# =============================================================================
node_modules/
.next/
out/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# =============================================================================
# Python / FastAPI backend
# =============================================================================
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
.venv/
venv/
env/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# =============================================================================
# Environment & secrets
# =============================================================================
# .env and the Firebase service-account JSON live in the BoilerCheck repo root.
# These globs match at any depth, so the root copies are already ignored.
.env
.env.local
.env.*.local
.envrc
*firebase-adminsdk*.json

# =============================================================================
# Testing & type checking
# =============================================================================
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# =============================================================================
# OS
# =============================================================================
.DS_Store
Thumbs.db
desktop.ini

# =============================================================================
# Editor
# =============================================================================
.vscode/
.idea/
*.swp
*.swo

# Cursor
.cursorignore
.cursorindexingignore

# =============================================================================
# Scraper
# =============================================================================
scrap/.venv

# Scraped/downloaded images (re-generated on every crawl; classified metadata
# lives in Firestore, so the local files are disposable).
/images/
scraper/images/
scraper/crawler/data/images/
**/data/images/

# Local crawler output artifacts (JSON dumps, logs) if any are produced.
scraper/crawler/data/*.json
scraper/crawler/data/*.log